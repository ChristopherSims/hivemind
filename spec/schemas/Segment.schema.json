{
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "text",
        "agent_mention"
      ],
      "title": "Kind",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "agent_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Id"
    }
  },
  "required": [
    "kind"
  ],
  "title": "Segment",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "text"
          }
        }
      },
      "then": {
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "agent_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "required": [
          "agent_id"
        ],
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "text": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
