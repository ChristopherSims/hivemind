{
  "$defs": {
    "Content": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown",
            "application/vnd.hivemind.chat+json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "segments": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Segment"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segments"
        }
      },
      "required": [
        "media_type"
      ],
      "title": "Content",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "application/vnd.hivemind.chat+json"
              }
            }
          },
          "then": {
            "required": [
              "segments"
            ],
            "properties": {
              "text": {
                "type": "null"
              },
              "segments": {
                "type": "array"
              }
            }
          },
          "else": {
            "required": [
              "text"
            ],
            "properties": {
              "segments": {
                "type": "null"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "run",
            "task",
            "event",
            "artifact",
            "board_post",
            "memory",
            "scope",
            "work_claim",
            "conflict",
            "control",
            "decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "agent_mention"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Segment",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "agent_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "required": [
              "agent_id"
            ],
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "text": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_post_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Client Post Id",
      "type": "string"
    },
    "kind": {
      "default": "message",
      "enum": [
        "message",
        "question",
        "finding",
        "decision",
        "warning",
        "request",
        "status",
        "answer"
      ],
      "title": "Kind",
      "type": "string"
    },
    "thread_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thread Id"
    },
    "parent_post_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Post Id"
    },
    "content": {
      "$ref": "#/$defs/Content"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "maxItems": 32,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "client_post_id",
    "content"
  ],
  "title": "PostCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
