{
  "additionalProperties": false,
  "description": "Fenced request to extend one live delivery lease. It never starts a new attempt.",
  "properties": {
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "delivery_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Id"
    },
    "ttl_seconds": {
      "default": 30,
      "maximum": 120,
      "minimum": 5,
      "title": "Ttl Seconds",
      "type": "integer"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "LeaseRenewal",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
