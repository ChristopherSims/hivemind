{
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "board_post",
        "artifact"
      ],
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "title": "MemoryExtractionRef",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
