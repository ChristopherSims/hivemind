{
  "$defs": {
    "Content": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown",
            "application/vnd.hivemind.chat+json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "segments": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Segment"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segments"
        }
      },
      "required": [
        "media_type"
      ],
      "title": "Content",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "application/vnd.hivemind.chat+json"
              }
            }
          },
          "then": {
            "required": [
              "segments"
            ],
            "properties": {
              "text": {
                "type": "null"
              },
              "segments": {
                "type": "array"
              }
            }
          },
          "else": {
            "required": [
              "text"
            ],
            "properties": {
              "segments": {
                "type": "null"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "MessageRetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "base_delay_seconds": {
          "default": 2,
          "maximum": 60,
          "minimum": 1,
          "title": "Base Delay Seconds",
          "type": "integer"
        },
        "max_delay_seconds": {
          "default": 60,
          "maximum": 600,
          "minimum": 1,
          "title": "Max Delay Seconds",
          "type": "integer"
        }
      },
      "title": "MessageRetryPolicy",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "agent_mention"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Segment",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "agent_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "required": [
              "agent_id"
            ],
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "text": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "hivemind",
      "default": "hivemind",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "message_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "from": {
      "maxLength": 128,
      "minLength": 1,
      "title": "From",
      "type": "string"
    },
    "to": {
      "maxLength": 128,
      "minLength": 1,
      "title": "To",
      "type": "string"
    },
    "sender_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sender Run Id"
    },
    "type": {
      "enum": [
        "request",
        "response",
        "question",
        "inform",
        "ack",
        "error",
        "cancel"
      ],
      "title": "Type",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Thread Id",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "in_reply_to": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "In Reply To"
    },
    "content": {
      "$ref": "#/$defs/Content"
    },
    "ttl_seconds": {
      "default": 3600,
      "maximum": 86400,
      "minimum": 1,
      "title": "Ttl Seconds",
      "type": "integer"
    },
    "retry_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/MessageRetryPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "message_id",
    "project_id",
    "from",
    "to",
    "type",
    "thread_id",
    "content"
  ],
  "title": "MessageCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
