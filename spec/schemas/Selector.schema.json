{
  "additionalProperties": false,
  "properties": {
    "agent_ids": {
      "anyOf": [
        {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Ids"
    },
    "semantic_query": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Query"
    },
    "match": {
      "default": "union",
      "enum": [
        "union",
        "intersection"
      ],
      "title": "Match",
      "type": "string"
    },
    "active_only": {
      "default": true,
      "title": "Active Only",
      "type": "boolean"
    },
    "max_agents": {
      "default": 10,
      "maximum": 50,
      "minimum": 1,
      "title": "Max Agents",
      "type": "integer"
    }
  },
  "title": "Selector",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "agent_ids"
      ],
      "properties": {
        "agent_ids": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "semantic_query"
      ],
      "properties": {
        "semantic_query": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "match": {
            "const": "intersection"
          }
        },
        "required": [
          "match"
        ]
      },
      "then": {
        "required": [
          "agent_ids",
          "semantic_query"
        ]
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
