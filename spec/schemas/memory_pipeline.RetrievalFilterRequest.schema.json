{
  "$defs": {
    "RepositorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Id"
        },
        "branch": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "commit": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        }
      },
      "title": "RepositorySnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "memory_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "title": "Memory Ids",
      "type": "array"
    },
    "limit": {
      "default": 200,
      "maximum": 500,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "require_current": {
      "default": true,
      "title": "Require Current",
      "type": "boolean"
    },
    "include_untracked": {
      "default": true,
      "title": "Include Untracked",
      "type": "boolean"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepositorySnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "project_id"
  ],
  "title": "RetrievalFilterRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
