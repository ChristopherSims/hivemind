{
  "$defs": {
    "Content": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown",
            "application/vnd.hivemind.chat+json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "segments": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Segment"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segments"
        }
      },
      "required": [
        "media_type"
      ],
      "title": "Content",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "application/vnd.hivemind.chat+json"
              }
            }
          },
          "then": {
            "required": [
              "segments"
            ],
            "properties": {
              "text": {
                "type": "null"
              },
              "segments": {
                "type": "array"
              }
            }
          },
          "else": {
            "required": [
              "text"
            ],
            "properties": {
              "segments": {
                "type": "null"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "agent_mention"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "agent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Segment",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "agent_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "required": [
              "agent_id"
            ],
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "text": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "Tracked request/reply workflow. The message itself uses the existing send validation.",
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "message_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "from_agent": {
      "maxLength": 128,
      "minLength": 1,
      "title": "From Agent",
      "type": "string"
    },
    "to": {
      "maxLength": 128,
      "minLength": 1,
      "title": "To",
      "type": "string"
    },
    "thread_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Thread Id",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "type": {
      "default": "request",
      "enum": [
        "request",
        "question"
      ],
      "title": "Type",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/Content"
    },
    "sender_run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sender Run Id"
    },
    "ttl_seconds": {
      "default": 3600,
      "maximum": 86400,
      "minimum": 1,
      "title": "Ttl Seconds",
      "type": "integer"
    },
    "response_deadline_seconds": {
      "anyOf": [
        {
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Deadline Seconds"
    }
  },
  "required": [
    "project_id",
    "message_id",
    "from_agent",
    "to",
    "thread_id",
    "content"
  ],
  "title": "ConversationRequestCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
