{
  "additionalProperties": false,
  "description": "Nexus-fenced durable approval of one exact (task, agent, run) pair.",
  "properties": {
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "agent_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "coordinator_epoch": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coordinator Epoch"
    },
    "reason": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "agent_id",
    "run_id",
    "reason"
  ],
  "title": "RoutingDispatch",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
