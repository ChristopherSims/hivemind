{
  "$defs": {
    "TaskRoutingRequirements": {
      "additionalProperties": false,
      "properties": {
        "required_runtime": {
          "anyOf": [
            {
              "enum": [
                "factory",
                "oh_my_pi",
                "a2a",
                "acp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Runtime"
        },
        "required_tools": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Required Tools",
          "type": "array"
        },
        "strict_sandbox": {
          "default": false,
          "title": "Strict Sandbox",
          "type": "boolean"
        }
      },
      "title": "TaskRoutingRequirements",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 65536,
      "title": "Description",
      "type": "string"
    },
    "scope_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Scope Ids",
      "type": "array"
    },
    "routing": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskRoutingRequirements"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "title": "TaskCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
