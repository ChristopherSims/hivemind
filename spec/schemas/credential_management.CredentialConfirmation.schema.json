{
  "additionalProperties": false,
  "description": "Explicit operator confirmation bound to a freshly reviewed impact.",
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "acknowledged_impact": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Acknowledged Impact",
      "type": "string"
    }
  },
  "required": [
    "expected_revision",
    "acknowledged_impact"
  ],
  "title": "CredentialConfirmation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
