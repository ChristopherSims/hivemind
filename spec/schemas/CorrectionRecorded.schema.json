{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "run",
            "task",
            "event",
            "artifact",
            "board_post",
            "memory",
            "scope",
            "work_claim",
            "conflict",
            "control",
            "decision"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Explicit correction of an earlier interpretation, without history rewriting.",
  "properties": {
    "text": {
      "maxLength": 65536,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "target_refs": {
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Target Refs",
      "type": "array"
    }
  },
  "required": [
    "text",
    "target_refs"
  ],
  "title": "CorrectionRecorded",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
