{
  "$defs": {
    "TaskEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "board_post",
            "artifact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "TaskEvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Execution Id",
      "type": "string"
    },
    "checkpoint_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "paused",
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "progress": {
      "maximum": 100,
      "minimum": 0,
      "title": "Progress",
      "type": "integer"
    },
    "summary": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/TaskEvidenceRef"
      },
      "maxItems": 32,
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "expected_revision",
    "run_id",
    "execution_id",
    "checkpoint_id",
    "status",
    "progress",
    "summary"
  ],
  "title": "TaskProgress",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
